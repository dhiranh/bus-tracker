# Copy to .env and fill in your own values.

# Primary TfL StopPoint ID to track. Optional — skipped if unset.
BUS_STOP_ID=490000119W

# Secondary TfL StopPoint ID. Optional — defaults to 490019347S.
STREATFIELD_STOP_ID=490019347S

# Minutes needed to walk to the stop, used to compute "Leave In". Optional — defaults to 5.
WALK_TIME_MINS=5

# Coordinates for the Open-Meteo weather lookup.
LAT=51.5074
LON=-0.1278
